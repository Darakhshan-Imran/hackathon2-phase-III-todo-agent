# Database - Neon PostgreSQL (must use asyncpg driver)
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx-xxx.region.aws.neon.tech/dbname?sslmode=require

# Groq API Key
api_key=gsk_your_groq_api_key_here

# JWT Configuration
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Deployment
ENVIRONMENT=production
ALLOWED_ORIGINS=["https://your-frontend.vercel.app"]

# MCP Remote Server (required)
MCP_SERVER_URL=https://your-mcp-server.vercel.app/mcp
MCP_API_KEY=your-mcp-api-key
MCP_SERVER_TIMEOUT=30
